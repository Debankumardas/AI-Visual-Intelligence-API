JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional
# Folder containing the model weights (default: ./models).
# MODELS_DIR=models
# Load AI models at startup (true) or on first request (false).
PRELOAD_MODELS=true
# Maximum frames run through the model per video; longer videos are
# sampled evenly.
VIDEO_MAX_PROCESSED_FRAMES=150
