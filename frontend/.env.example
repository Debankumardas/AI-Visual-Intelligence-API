# Where the dev server forwards /api and /health requests.
# Defaults to the local FastAPI backend.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional: call the backend directly instead of through the dev-server
# proxy (the backend then needs CORS enabled for this frontend's origin).
# By default requests are same-origin ("/") and go through the proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000
